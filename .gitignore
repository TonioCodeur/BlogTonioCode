# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.production
.env.development
.env.test
.env.staging
.env.local
.env.vercel
.env.staging
.env.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma
prisma/migrations
/generated/prisma
/app/generated/prisma

.vercel
# claude
/worktrees/*/*.*

# user uploads (cover images written by /api/upload/post-cover)
/public/uploads/